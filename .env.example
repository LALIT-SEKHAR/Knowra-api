PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# On Railway: CLIENT_ORIGIN=https://your-frontend.up.railway.app

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/knowra?retryWrites=true&w=majority
# Prefer Atlas standard URI if mongodb+srv fails DNS on some hosts

JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Knowra <you@gmail.com>

NODE_ENV=production

# Optional
# OTP_EXPIRY_MINUTES=10
# MAX_UPLOAD_BYTES=20971520
# VECTOR_INDEX_NAME=chunk_embedding_index
