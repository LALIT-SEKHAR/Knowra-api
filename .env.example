PORT=4000
# Comma-separated allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
# Production example:
# CLIENT_ORIGIN=https://knowra-cyan.vercel.app

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/knowra?retryWrites=true&w=majority
# Prefer Atlas standard URI if mongodb+srv fails DNS on some hosts

JWT_SECRET=change-me-to-a-long-random-string
# Production rejects this placeholder and any secret shorter than 32 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Production rejects this example key. Changing it makes stored provider keys unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Knowra <onboarding@resend.dev>

# Public HTTPS logo for OTP emails (no attachment). Falls back to https CLIENT_ORIGIN/logo.png.
# EMAIL_LOGO_URL=https://knowra-cyan.vercel.app/logo.png

# Preferred when SMTP ports are blocked (e.g. some serverless hosts). Get a key at https://resend.com
RESEND_API_KEY=

# Optional locally. Required in production so /api/cron/jobs is not public.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when the project env var is set.
CRON_SECRET=

NODE_ENV=production

# Optional
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# MAX_UPLOAD_BYTES=1073741824
# VECTOR_INDEX_NAME=chunk_embedding_index
